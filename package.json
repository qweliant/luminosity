{
  "name": "luminosity",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @luminosity/values dev",
    "dev:relational": "bun run --filter @luminosity/relational dev",
    "build": "bun run --filter @luminosity/values build",
    "build:relational": "bun run --filter @luminosity/relational build",
    "preview": "bun run --filter @luminosity/values preview",
    "server": "bun --hot server.ts",
    "signal": "bun run --filter @luminosity/values signal",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
